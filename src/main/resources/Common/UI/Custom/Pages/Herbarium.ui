$C = "../Common.ui";
$Sounds = "../Sounds.ui";
$H = "Herbarium/components/HerbariumCommon.ui";

@progressBarWidth = 1018;

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Height: 825, Width: 1070);

    #Title {
      Group {
        LayoutMode: Center;

        Button #InfoButton {
          Anchor: (Width: 24, Height: 24, Left: 15);
          Style: (
            Default: (Background: (TexturePath: "Herbarium/textures/InfoButtonBackground.png", Border: 2)),
            Hovered: (Background: (TexturePath: "Herbarium/textures/InfoButtonBackgroundHovered.png", Border: 2))
          );

          Label {
            Style: (FontSize: 14, TextColor: #b4c8c9, HorizontalAlignment: Center, RenderBold: true, VerticalAlignment: Center);
            Text: "?";
          }
        }

        $H.@FlexSpacer {}

        Label #TitleLabel {
          Style: $H.@JournalTitleStyle;
          Text: "Herbarium";
        }

        $H.@FlexSpacer {}

        Group {
          LayoutMode: Right;
          Anchor: (Width: 24, Right: 15);
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 9);

      Group #Categories {
        Background: (TexturePath: "Herbarium/textures/MemoriesRunes.png", Border: 15);
        FlexWeight: 1;

        Group {
          LayoutMode: TopScrolling;
          Anchor: (Top: 15);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          FlexWeight: 1;

          Group #IconList {
            LayoutMode: LeftCenterWrap;
          }
        }
      }

      Group #Footer {
        Anchor: (Height: 175);
        LayoutMode: Top;
        Background: (TexturePath: "Herbarium/textures/ContainerBackground.png", Border: 23);
        Padding: (Horizontal: 20, Vertical: 15);

        $H.@FlexSpacer {}

        Group #ChestMarkers {
          Anchor: (Bottom: -15, Left: -14);
        }

        Group {
          Background: "Herbarium/textures/MemoriesProgress/MemoriesBarBg.png";
          Anchor: (Height: 22, Width: @progressBarWidth, Bottom: 30);
          Padding: (Full: 6);

          ProgressBar #PlantsProgressBar {
            BarTexturePath: "Herbarium/textures/MemoriesProgress/MemoriesBarFill.png";
            EffectTexturePath: "Herbarium/textures/MemoriesProgress/MemoriesBarTipOfTheBar.png";
            EffectWidth: 114;
            EffectHeight: 32;
            EffectOffset: 104;
          }

          ProgressBar #PlantsProgressBarTexture {
            BarTexturePath: "Herbarium/textures/MemoriesProgress/MemoriesBarTexture.png";
          }
        }

        $H.@FlexSpacer {}

        Group {
          LayoutMode: Left;

          Group {
            FlexWeight: 1;
            LayoutMode: Left;

            Label #TotalCollected {
              Style: $H.@JournalTitleStyle;
              Text: "";
            }
          }

          $C.@TextButton #RewardsButton {
            @Sounds = $Sounds.@ButtonMemoryRestore;
            Anchor: (Width: 330, Height: 42);
            Text: "";
            Disabled: true;
          }

          $H.@FlexSpacer {}
        }
      }
    }
  }
}

$C.@BackButton {}
