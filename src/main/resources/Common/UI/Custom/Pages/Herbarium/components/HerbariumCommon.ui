// Shared styles and reusable components for the Herbarium pages.
// Imported by page orchestrators with: $H = "HerbariumCommon.ui";
// (from Pages/Herbarium.ui: $H = "Herbarium/HerbariumCommon.ui";)

$Common = "../../../Common.ui";
$Sounds = "../../../Sounds.ui";

@JournalTitleStyle = LabelStyle(
  FontSize: 15,
  VerticalAlignment: Center,
  RenderUppercase: true,
  TextColor: #b4c8c9,
  FontName: "Default",
  RenderBold: true,
  LetterSpacing: 0.5
);

@PlantNameStyle = LabelStyle(
  FontSize: 25,
  VerticalAlignment: Center,
  HorizontalAlignment: Start,
  RenderUppercase: true,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  LetterSpacing: 0.5,
  Wrap: true
);

@PlantIdStyle = LabelStyle(
  FontSize: 14,
  VerticalAlignment: Center,
  HorizontalAlignment: Start,
  RenderUppercase: false,
  TextColor: #565a68,
  FontName: "Secondary",
  RenderBold: false,
  LetterSpacing: 0.5,
  Wrap: true
);

@PlantStatusStyle = LabelStyle(
  FontSize: 15,
  TextColor: #565a68,
  FontName: "Secondary",
  HorizontalAlignment: Center,
  Wrap: true,
  RenderUppercase: false
);

@ContainerTitleStyle = LabelStyle(
  FontSize: 18,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  HorizontalAlignment: Start,
  Wrap: true,
  RenderUppercase: true,
  RenderBold: true,
  LetterSpacing: 0.5
);

@SectionTitleStyle = LabelStyle(
  FontSize: 16,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  HorizontalAlignment: Start,
  Wrap: true,
  RenderUppercase: false,
  RenderBold: true,
  LetterSpacing: 0.5
);

@EntryStyle = LabelStyle(
  FontSize: 14,
  TextColor: #8a8f9e,
  FontName: "Secondary",
  HorizontalAlignment: Start,
  Wrap: true,
  RenderBold: false,
  RenderUppercase: false
);

// Spacer that absorbs free space (e.g. to center content vertically)
@FlexSpacer = Group {
  FlexWeight: 1;
};

// Fixed empty gap between blocks; override @Pad to change size/direction
@Spacer = Group {
  @Pad = Padding(Vertical: 8);
  Padding: @Pad;
};

// Titled container: background box with a title label on top.
// Usage: $H.@TitledContainer #MyContainer { ...content children... }
// Java addresses the title as "#MyContainer #ContainerTitle".
@TitledContainer = Group {
  LayoutMode: Top;
  Background: (TexturePath: "../textures/ContainerBackgroundSecondary.png", Border: 23);
  Padding: (Full: 12);

  Label #ContainerTitle {
    Style: @ContainerTitleStyle;
    Text: "";
  }

  @Spacer {
    @Pad = Padding(Bottom: 8);
  }
};

// Titled section: background box with a title label and a list container.
// Usage: $H.@Section #MySection {}
// Java addresses "#MySection #SectionTitle" and appends into "#MySection #SectionList".
@Section = Group {
  LayoutMode: Top;
  Background: (TexturePath: "../textures/SectionBackground.png", Border: 8);
  Padding: (Full: 8);

  Label #SectionTitle {
    Style: @SectionTitleStyle;
    Text: "";
    Visible: false;
  }

  @Spacer {
    @Pad = Padding(Vertical: 4);
  }

  Group #SectionList {
    LayoutMode: Top;
  }
};

// Section box with a header row: title left (#SectionTitle, FlexWeight 1), optional
// icon right (#HeaderIcon, 48px, hidden by default), then a wrapping list.
// Usage: $H.@SectionBox #MySection { @BoxPad = ...; }   (override @BoxPad to change padding)
// Java addresses "#MySection #SectionTitle", "#MySection #HeaderIcon",
// and appends into "#MySection #SectionList".
@SectionBox = Group {
  @BoxPad = Padding(Full: 8);

  LayoutMode: Top;
  Background: (TexturePath: "../textures/SectionBackground.png", Border: 8);
  Padding: @BoxPad;

  Group #SectionHeader {
    LayoutMode: CenterMiddle;

    Label #SectionTitle {
      Style: (...@SectionTitleStyle, VerticalAlignment: Center);
      Text: "";
      FlexWeight: 1;
      Visible: false;
    }

    AssetImage #HeaderIcon {
      Anchor: (Width: 48, Height: 48);
      FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
      TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
      TooltipText: "";
      Visible: false;
    }
  }

  @Spacer {
    @Pad = Padding(Vertical: 4);
  }

  Group #SectionList {
    LayoutMode: LeftCenterWrap;
    Anchor: (Full: 0);
  }
};

// Small tile for a crafting ingredient: icon + tooltip name (amount sits below the tile).
// Same structure as PlantTile (centered icon over labels) on a section background.
// Usage: $H.@IngredientTile #MyTile {}
// Java addresses "#MyTile #IngredientIcon" (AssetPath), "#IngredientName", "#IngredientAmount".
@IngredientTile = Group {
  Anchor: (Width: 96, Height: 124, Right: 8, Bottom: 8);
  LayoutMode: Top;
  Background: (TexturePath: "../textures/SectionBackground.png", Border: 8);
  Padding: (Full: 6);
  TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
  TooltipText: "";

  Group {
    LayoutMode: Middle;
    FlexWeight: 1;

    AssetImage #IngredientIcon {
      Anchor: (Width: 48, Height: 48);
      FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
    }
  }
};

// Horizontal row of "how" icons shown under a Gives / Plants source tile:
// break (32), shears (32), salvage (40), growth (40), magical growth (40), craft (40).
// Java toggles each "#IconX.Visible" and sets its TooltipTextSpans.
@SourceInteractions = Group {
  LayoutMode: CenterMiddle;
  Padding: (Top: 2);

  Group #IconBreak {
    Anchor: (Width: 32, Height: 32, Right: 4);
    Background: "../textures/InteractionBreak.png";
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    TooltipText: "";
    Visible: false;
  }

  Group #IconHarvest {
    Anchor: (Width: 40, Height: 40, Right: 4);
    Background: "../textures/InteractionHarvest.png";
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    TooltipText: "";
    Visible: false;
  }

  Group #IconShears {
    Anchor: (Width: 32, Height: 32, Right: 4);
    Background: "../textures/InteractionShears.png";
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    TooltipText: "";
    Visible: false;
  }

  Group #IconSalvage {
    Anchor: (Width: 40, Height: 40, Right: 4);
    Background: "../textures/InteractionSalvage.png";
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    TooltipText: "";
    Visible: false;
  }

  Group #IconGrowth {
    Anchor: (Width: 40, Height: 40);
    Background: "../textures/Growth.png";
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    TooltipText: "";
    Visible: false;
  }

  Group #IconGrowthMagical {
    Anchor: (Width: 40, Height: 40);
    Background: "../textures/GrowthMagical.png";
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    TooltipText: "";
    Visible: false;
  }

  // Craft icon: falls back to InteractionCraft.png; when the recipe's bench is known,
  // #CraftBenchIcon shows the bench's own icon on top and the tooltip names the bench.
  Group #IconCraft {
    Anchor: (Width: 40, Height: 40);
    Background: "../textures/InteractionCraft.png";
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    TooltipText: "";
    Visible: false;

    AssetImage #CraftBenchIcon {
      Anchor: (Full: 0);
      FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
      Visible: false;
    }
  }
};

// Untitled section body: same background as @Section, wrapping a list directly.
// Usage: $H.@ListBox { Group #MyList { LayoutMode: LeftCenterWrap; Anchor: (Full: 0); } }
@ListBox = Group {
  LayoutMode: Top;
  Background: (TexturePath: "../textures/SectionBackground.png", Border: 8);
  Padding: (Full: 8);
};

// Plant tile, same as the LeftPanel grid tiles (moved here so ingredient lists can
// reuse it). Java addresses "#Icon", "#ButtonNotSelected"/"#ButtonSelected",
// "#EmptyBackground" relative to the tile root.
@PlantTile = Group {
  @Width = 144;
  @Height = 176;
  @IconSize = 112;
  @Gap = 16;

  Anchor: (Width: @Width, Height: @Height, Right: @Gap, Bottom: @Gap);
  Padding: (Full: 0);

  Group #EmptyBackground {
    Visible: false;
    Background: (TexturePath: "../textures/Tiles/TileEmpty.png", Border: 8);
    TooltipText: %server.memories.general.undiscovered.tooltipText;
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
  }

  TextButton #ButtonNotSelected {
    Visible: false;
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    Style: (
      Sounds: $Sounds.@ButtonsLight,
      Default: (
        LabelStyle: (
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        ),
        Background: (TexturePath: "../textures/Tiles/TileDefault.png", Border: 8)
      ),
      Hovered: (
        LabelStyle: (
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        ),
        Background: (TexturePath: "../textures/Tiles/TileHovered.png", Border: 8)
      )
    );
    FlexWeight: 1;
  }

  TextButton #ButtonSelected {
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    Visible: false;
    Style: (
      Sounds: $Sounds.@ButtonsLight,
      Default: (
        LabelStyle: (
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        ),
        Background: (TexturePath: "../textures/Tiles/TileSelected.png", Border: 8)
      )
    );
    FlexWeight: 1;
  }

  Group {
    LayoutMode: Middle;
    Anchor: (Full: 0);

    AssetImage #Icon {
      Anchor: (Width: @IconSize, Height: @IconSize);
      FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
    }
  }
};
