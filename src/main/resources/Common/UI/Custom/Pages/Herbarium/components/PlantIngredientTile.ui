$Herbarium = "HerbariumCommon.ui";

// Plant ingredient: same tile as the LeftPanel grid but shrunk to the ingredient
// tile size (96x124, icon 48), with the amount below it.
Group {
  LayoutMode: Top;

  $Herbarium.@PlantTile #PlantTile {
    @Width = 96;
    @Height = 124;
    @IconSize = 48;
    @Gap = 8;
  }

  Label #IngredientAmount {
    Style: (...$Herbarium.@EntryStyle, HorizontalAlignment: Center);
    Text: "";
  }
}
