$Common = "../../../Common.ui";
$Sounds = "../../../Sounds.ui";
$Herbarium = "HerbariumCommon.ui";

@CategoryButtonLabelStyle = LabelStyle(
  Wrap: true,
  HorizontalAlignment: Center,
  VerticalAlignment: End,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  RenderUppercase: true,
  FontSize: 15
);

@CategoryCounterStyle = LabelStyle(
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  RenderUppercase: true,
  FontSize: 13,
  HorizontalAlignment: End
);

// "current/total" counter labels; override @C for the text color.
// Java addresses "#Current.Text" and "#Total.Text" under the parent counter group.
@CounterLabels = Group {
  @C = #b4c8c9;

  LayoutMode: Right;

  Label #Current {
    Text: "0";
    Style: (...@CategoryCounterStyle, TextColor: @C);
  }

  Label {
    Text: "/";
    Style: (...@CategoryCounterStyle, TextColor: @C);
  }

  Label #Total {
    Text: "0";
    Style: (...@CategoryCounterStyle, TextColor: @C);
  }
};

Group {
  Anchor: (Width: 144, Height: 176, Right: 16, Bottom: 16);
  Padding: (Full: 8);

  Group #CompleteCategoryBackground {
    Background: (TexturePath: "../textures/Tiles/TileComplete.png", Border: 8);
    Visible: false;
  }

  Group {
    LayoutMode: Right;
    Anchor: (Right: 5, Top: 5);

    @CounterLabels #NotCompleteCategoryCounter {
      Visible: false;
      @C = #b4c8c9;
    }

    Group #CompleteCategoryCounter {
      LayoutMode: Right;
      Visible: false;

      $Herbarium.@FlexSpacer {}

      Group {
        Background: "../textures/Checkmark.png";
        Anchor: (Width: 16, Height: 16, Right: 5, Top: 0);
      }

      @CounterLabels {
        @C = #39f493;
      }
    }
  }

  TextButton #Button {
    Padding: (Bottom: 10);
    Style: (
      Sounds: $Sounds.@ButtonsLight,
      Default: (
        LabelStyle: @CategoryButtonLabelStyle,
        Background: (TexturePath: "../textures/Tiles/TileDefault.png", Border: 8)
      ),
      Hovered: (
        LabelStyle: @CategoryButtonLabelStyle,
        Background: (TexturePath: "../textures/Tiles/TileHovered.png", Border: 8)
      )
    );
    FlexWeight: 1;
  }

  AssetImage #CategoryIcon {
    Anchor: (Width: 112, Height: 112);
    FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
  }
}
