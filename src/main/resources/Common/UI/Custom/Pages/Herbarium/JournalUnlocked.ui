$Common = "../../Common.ui";
$Intro = "../../Common/IntroModal.ui";

// Texts are set at runtime by HerbariumIntroPage: .ui documents cannot
// reference plugin translation keys with %refs, the client fails to load
// the document when the key is not resolvable at parse time.
//
// The illustration is shown next to the text like the vanilla Memories
// unlock modal. The @ImageWidth/@ImageHeight are logical (1x) sizes; the
// asset JournalUnlocked/Herbarium_Journal@2x.png renders at half its
// pixel size. Override blocks cannot override nested template elements
// (the template's #TitleLabel), so the texts are plain labels added to
// the column.
$Intro.@IntroModal {
  @ImageWidth = 315;
  @ImageHeight = 393;

  #ContentText {
    Label #ModalTitle {
      Style: (HorizontalAlignment: Start, FontName: "Secondary", TextColor: #b6cfee, FontSize: 28, RenderBold: true, RenderUppercase: true, Wrap: true);
      Text: "";
    }

    Label #ModalBullet1 {
      Anchor: (Top: 15);
      Style: (HorizontalAlignment: Start, FontSize: 18, Wrap: true, TextColor: #778393);
      Text: "";
    }

    Label #ModalBullet2 {
      Anchor: (Top: 15);
      Style: (HorizontalAlignment: Start, FontSize: 18, Wrap: true, TextColor: #778393);
      Text: "";
    }

    Label #ModalBullet3 {
      Anchor: (Top: 15);
      Style: (HorizontalAlignment: Start, FontSize: 18, Wrap: true, TextColor: #778393);
      Text: "";
    }
  }

  #ContentImage {
    Group {
      Background: "JournalUnlocked/Herbarium_Journal.png";
    }
  }

  #Body {
    $Common.@TextButton #OpenJournalButton {
      @Anchor = $Intro.@ButtonAnchor;
      @Text = "";
    }
  }
}
