$Common = "../../../Common.ui";
$Herbarium = "HerbariumCommon.ui";

// Merchant tile for Obtained from / Other: the merchant's generated model icon on a
// section-background tile (merchant name as tooltip), with the trade cost below the
// tile: cost item icon + "x<amount>", tooltip "Buy".
// Java addresses "#MerchantTile #IngredientIcon" (AssetPath), "#MerchantTile.TooltipTextSpans",
// "#CostRow #CostIcon" (AssetPath), "#CostRow #CostAmount" (.Text), "#CostRow.TooltipTextSpans".
Group {
  LayoutMode: Top;
  Anchor: (Width: 93, Right: 8, Bottom: 8);

  $Herbarium.@IngredientTile #MerchantTile {
    @Width = 93;
    @Height = 114;
    @IconSize = 60;
    @Gap = 0;
  }

  Group #CostRow {
    LayoutMode: CenterMiddle;
    Anchor: (Height: 28);
    Padding: (Top: 2);
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    TooltipText: "";

    AssetImage #CostIcon {
      Anchor: (Width: 24, Height: 24, Right: 4);
      FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
    }

    Label #CostAmount {
      Style: (...$Herbarium.@EntryStyle, HorizontalAlignment: Start);
      Text: "";
    }
  }
}
