$C = "../../Common.ui";

@JournalTitleStyle = LabelStyle(
  FontSize: 15,
  VerticalAlignment: Center,
  RenderUppercase: true,
  TextColor: #b4c8c9,
  FontName: "Default",
  RenderBold: true,
  LetterSpacing: 0.5
);

@PlantNameStyle = LabelStyle(
  FontSize: 25,
  VerticalAlignment: Center,
  HorizontalAlignment: Start,
  RenderUppercase: true,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  LetterSpacing: 0.5,
  Wrap: true
);

@PlantIdStyle = LabelStyle(
  FontSize: 14,
  VerticalAlignment: Center,
  HorizontalAlignment: Start,
  RenderUppercase: false,
  TextColor: #565a68,
  FontName: "Secondary",
  RenderBold: false,
  LetterSpacing: 0.5,
  Wrap: true
);

@PlantStatusStyle = LabelStyle(
  FontSize: 15,
  TextColor: #565a68,
  FontName: "Secondary",
  HorizontalAlignment: Center,
  Wrap: true,
  RenderUppercase: false
);

@PlantContainerTitleStyle = LabelStyle(
  FontSize: 18,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  HorizontalAlignment: Start,
  Wrap: true,
  RenderUppercase: true,
  RenderBold: true,
  LetterSpacing: 0.5
);

@PlantLocationsCategoryTitleStyle = LabelStyle(
  FontSize: 16,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  HorizontalAlignment: Start,
  Wrap: true,
  RenderUppercase: false,
  RenderBold: true,
  LetterSpacing: 0.5
);

@PlantLocationStyle = LabelStyle(
  FontSize: 14,
  TextColor: #8a8f9e,
  FontName: "Secondary",
  HorizontalAlignment: Start,
  Wrap: true,
  RenderBold: false,
  RenderUppercase: false
);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Height: 825, Width: 1070);

    #Title {
      Group {
        LayoutMode: Center;

        Label #TitleLabel {
          Style: @JournalTitleStyle;
          Text: "Herbarium";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 9);

      Group {
        LayoutMode: Left;
        FlexWeight: 1;

        // Left panel - plant grid
        Group #LeftPanel {
          LayoutMode: Top;
          FlexWeight: 1;
          Padding: (Left: 20, Right: 5, Vertical: 16);

          Group #CategoryHeader {
            LayoutMode: Left;

            Label #CategoryTitle {
              Style: (...@JournalTitleStyle, TextColor: #89899f);
              Text: "";
            }

            Group {
              FlexWeight: 1;
            }

            Label #CategoryCount {
              Style: (...@JournalTitleStyle, TextColor: #89899f);
              Text: "0/0";
            }
          }

          // Plant grid
          Group {
            FlexWeight: 1;

            Group {
              LayoutMode: TopScrolling;
              Anchor: (Vertical: 16);
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              FlexWeight: 1;

              Group #IconList {
                LayoutMode: LeftWrap;
              }
            }
          }

          // Back button
          Group {
            LayoutMode: Left;

            $C.@SecondaryTextButton #BackButton {
              Anchor: (Width: 150, Height: 42);
              Text: %client.general.button.back;
            }
          }
        }

        // Right panel - plant details
        Group #RightPanel {
          LayoutMode: Top;
          FlexWeight: 1;
          Padding: (Right: 20, Left: 5, Vertical: 16);

          Group #Background {
            Background: (TexturePath: "ContainerBackgroundSecondary.png", Border: 23);
            LayoutMode: Top;
            FlexWeight: 1;

            Group #Header {
              LayoutMode: Left;
              Anchor: (Top: 35, Height: 96);
              Padding: (Horizontal: 20);

              AssetImage #PlantIcon {
                Anchor: (Width: 112, Height: 112);
                FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
              }

              Group #HeaderText {
                LayoutMode: Top;
                FlexWeight: 1;
                Padding: (Left: 16);

                Group { FlexWeight: 1; }

                Label #PlantName {
                  Style: @PlantNameStyle;
                  Text: "";
                }

                Label #PlantId {
                  Style: @PlantIdStyle;
                  Text: "";
                }

                Group { FlexWeight: 1; }
              }
            }

            Group #PlantContent {
              LayoutMode: TopScrolling;
              Padding: (Horizontal: 20, Vertical: 20);
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              FlexWeight: 1;

              Group {
                Padding: (Bottom: 2);
              }

              Group #PlantContainerLocations {
                LayoutMode: Top;

                Label #PlantContainerLocationsTitle {
                  Style: @PlantContainerTitleStyle;
                  Text: "";
                }

                Group { Padding: (Bottom: 8); }

                Group #PlantLocationsZones {
                  LayoutMode: Top;
                  Background: (TexturePath: "SectionBackground.png", Border: 8);
                  Padding: (Full: 8);

                  Label #PlantLocationsZonesTitle {
                    Style: @PlantLocationsCategoryTitleStyle;
                    Text: "";
                    Visible: false;
                  }

                  Group { Padding: (Vertical: 2); }

                  Group #ZonesList {
                    LayoutMode: Top;
                  }
                }

                Group { Padding: (Vertical: 8); }

                Group #PlantLocationsRegions {
                  LayoutMode: Top;
                  Background: (TexturePath: "SectionBackground.png", Border: 8);
                  Padding: (Full: 8);

                  Label #PlantLocationsRegionsTitle {
                    Style: @PlantLocationsCategoryTitleStyle;
                    Text: "";
                    Visible: false;
                  }

                  Group { Padding: (Vertical: 2); }

                  Group #RegionsList {
                    LayoutMode: Top;
                  }
                }

                Group { Padding: (Vertical: 8); }

                Group #PlantLocationsPortals {
                  LayoutMode: Top;
                  Background: (TexturePath: "SectionBackground.png", Border: 8);
                  Padding: (Full: 8);

                  Label #PlantLocationsPortalsTitle {
                    Style: @PlantLocationsCategoryTitleStyle;
                    Text: "";
                    Visible: false;
                  }

                  Group { Padding: (Vertical: 2); }

                  Group #PortalsList {
                    LayoutMode: Top;
                  }
                }

                Label #PlantLocationUnknown {
                  Style: @PlantLocationStyle;
                  Text: "";
                  Visible: false;
                }
              }
            }

            Label #PlantDiscovery {
              Style: @PlantStatusStyle;
              Anchor: (Bottom: 35);
              Padding: (Horizontal: 15);
              Text: "";
            }
          }
        }
      }
    }
  }
}
