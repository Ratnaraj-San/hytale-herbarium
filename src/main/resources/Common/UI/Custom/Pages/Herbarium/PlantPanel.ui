$Common = "../../Common.ui";
$Herbarium = "components/HerbariumCommon.ui";
$Left = "components/PlantPanelLeft.ui";
$Right = "components/PlantPanelRight.ui";

$Common.@PageOverlay {
  LayoutMode: Middle;

  $Common.@DecoratedContainer {
    Anchor: (Height: 825, Width: 1070);

    #Title {
      Group {
        LayoutMode: Center;

        Label #TitleLabel {
          Style: $Herbarium.@JournalTitleStyle;
          Text: "Herbarium";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 9);

      Group {
        LayoutMode: Left;
        FlexWeight: 1;

        $Left.@LeftPanel #LeftPanel {}
        $Right.@RightPanel #RightPanel {}
      }
    }
  }
}
