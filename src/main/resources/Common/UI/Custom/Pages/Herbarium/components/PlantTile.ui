$Common = "../../../Common.ui";
$Sounds = "../../../Sounds.ui";

Group {
  Anchor: (Width: 144, Height: 176, Right: 16, Bottom: 16);
  Padding: (Full: 0);

  Group #EmptyBackground {
    Visible: false;
    Background: (TexturePath: "../textures/Tiles/TileEmpty.png", Border: 8);
    TooltipText: %server.memories.general.undiscovered.tooltipText;
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
  }

  TextButton #ButtonNotSelected {
    Visible: false;
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    Style: (
      Sounds: $Sounds.@ButtonsLight,
      Default: (
        LabelStyle: (
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        ),
        Background: (TexturePath: "../textures/Tiles/TileDefault.png", Border: 8)
      ),
      Hovered: (
        LabelStyle: (
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        ),
        Background: (TexturePath: "../textures/Tiles/TileHovered.png", Border: 8)
      )
    );
    FlexWeight: 1;
  }

  TextButton #ButtonSelected {
    TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
    Visible: false;
    Style: (
      Sounds: $Sounds.@ButtonsLight,
      Default: (
        LabelStyle: (
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        ),
        Background: (TexturePath: "../textures/Tiles/TileSelected.png", Border: 8)
      )
    );
    FlexWeight: 1;
  }

  Group {
    LayoutMode: Middle;
    Anchor: (Full: 0);

    AssetImage #Icon {
      Anchor: (Width: 112, Height: 112);
      FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
    }
  }
}
