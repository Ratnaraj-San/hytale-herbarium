$Common = "../../../Common.ui";
$Herbarium = "HerbariumCommon.ui";

@RightPanel = Group {
  LayoutMode: Top;
  FlexWeight: 1;
  Padding: (Right: 20, Left: 5, Vertical: 16);

  Group #Background {
    Background: (TexturePath: "../textures/ContainerBackgroundSecondary.png", Border: 23);
    LayoutMode: Top;
    FlexWeight: 1;

    Group #Header {
      LayoutMode: Left;
      Anchor: (Top: 35, Height: 96);
      Padding: (Horizontal: 20);

      AssetImage #PlantIcon {
        Anchor: (Width: 112, Height: 112);
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
      }

      Group #HeaderText {
        LayoutMode: Top;
        FlexWeight: 1;
        Padding: (Left: 16);

        $Herbarium.@FlexSpacer {}

        Label #PlantName {
          Style: $Herbarium.@PlantNameStyle;
          Text: "";
        }

        // Dev view only: plant ID in a borderless text field so it can be
        // selected and copied (Ctrl+C). Java toggles #PlantIdWrap.Visible and
        // sets #PlantId.Value + the tooltip.
        Group #PlantIdWrap {
          TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
          TooltipText: "";
          Visible: false;

          TextField #PlantId {
            Style: (...$Herbarium.@PlantIdFieldStyle, FontSize: 14);
            Background: (Color: #000000(0));
            Anchor: (Height: 22);
            Padding: (Horizontal: 0);
            Value: "";
          }
        }

        $Herbarium.@FlexSpacer {}
      }
    }

    Group #PlantContent {
      LayoutMode: TopScrolling;
      Padding: (Horizontal: 20, Vertical: 20);
      ScrollbarStyle: $Common.@DefaultScrollbarStyle;
      FlexWeight: 1;

      $Herbarium.@TitledContainer #PlantContainerLocations {
        Group #ZonedRegions {
          LayoutMode: Top;
        }

        $Herbarium.@Section #PlantLocationsPortals {}

        Label #PlantLocationUnknown {
          Style: $Herbarium.@EntryStyle;
          Text: "";
          Visible: false;
        }
      }

      $Herbarium.@Spacer {
        @Pad = Padding(Vertical: 12);
      }

      $Herbarium.@TitledContainer #PlantContainerObtainedFrom {
        Group #PlantContainerObtainedFromInteractions {
          LayoutMode: Top;
          Background: (TexturePath: "../textures/SectionBackground.png", Border: 8);
          Padding: (Full: 8);

          Group #InteractionsHeader {
            LayoutMode: CenterMiddle;

            Label #SectionTitle {
              Style: (...$Herbarium.@SectionTitleStyle, VerticalAlignment: Center);
              Text: "";
              FlexWeight: 1;
              Visible: false;
            }

            Group #InteractionsRow {
              LayoutMode: CenterMiddle;

              Group #InteractionBreak {
                Anchor: (Width: 40, Height: 40);
                Background: "../textures/InteractionBreak.png";
                TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
                TooltipText: "";
              }

              Group #InteractionHarvest {
                Anchor: (Width: 48, Height: 48);
                Padding: (Left: 12);
                Background: "../textures/InteractionHarvest.png";
                TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
                TooltipText: "";
              }

              Group #InteractionShears {
                Anchor: (Width: 48, Height: 48);
                Padding: (Left: 12);
                Background: "../textures/InteractionShears.png";
                TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
                TooltipText: "";
              }
            }
          }

          Group #SectionList {
            LayoutMode: Top;
          }
        }

        $Herbarium.@Spacer #SpacerAfterInteractions { Visible: false; }

        $Herbarium.@SectionBox #PlantContainerObtainedFromCrafting {}

        $Herbarium.@Spacer #SpacerAfterCrafting { Visible: false; }

        $Herbarium.@SectionBox #PlantContainerObtainedFromPlants {
          @BoxPad = Padding(Horizontal: 8, Top: 16, Bottom: 8);
        }
      }

      $Herbarium.@Spacer #SpacerAfterObtainedFrom { Visible: false; }

      // Gives: reverse of Obtained from / Plants. The container holds an untitled
      // section box (@ListBox) whose content is the wrapping list of tiles.
      $Herbarium.@TitledContainer #PlantContainerGives {
        $Herbarium.@ListBox {
          Group #GivesList {
            LayoutMode: LeftCenterWrap;
            Anchor: (Full: 0);
          }
        }
      }

    }

    Label #PlantDiscovery {
      Style: $Herbarium.@PlantStatusStyle;
      Anchor: (Bottom: 35);
      Padding: (Horizontal: 15);
      Text: "";
    }
  }
};
