$Common = "../../../Common.ui";
$Herbarium = "HerbariumCommon.ui";

@RightPanel = Group {
  LayoutMode: Top;
  FlexWeight: 1;
  Padding: (Right: 20, Left: 5, Vertical: 16);

  Group #Background {
    Background: (TexturePath: "../textures/ContainerBackgroundSecondary.png", Border: 23);
    LayoutMode: Top;
    FlexWeight: 1;

    Group #Header {
      LayoutMode: Left;
      Anchor: (Top: 35, Height: 96);
      Padding: (Horizontal: 20);

      AssetImage #PlantIcon {
        Anchor: (Width: 112, Height: 112);
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
      }

      Group #HeaderText {
        LayoutMode: Top;
        FlexWeight: 1;
        Padding: (Left: 16);

        $Herbarium.@FlexSpacer {}

        Label #PlantName {
          Style: $Herbarium.@PlantNameStyle;
          Text: "";
        }

        Label #PlantId {
          Style: $Herbarium.@PlantIdStyle;
          Text: "";
        }

        $Herbarium.@FlexSpacer {}
      }
    }

    Group #PlantContent {
      LayoutMode: TopScrolling;
      Padding: (Horizontal: 20, Vertical: 20);
      ScrollbarStyle: $Common.@DefaultScrollbarStyle;
      FlexWeight: 1;

      $Herbarium.@TitledContainer #PlantContainerLocations {
        Group #ZonedRegions {
          LayoutMode: Top;
        }

        $Herbarium.@Section #PlantLocationsPortals {}

        Label #PlantLocationUnknown {
          Style: $Herbarium.@EntryStyle;
          Text: "";
          Visible: false;
        }
      }

      $Herbarium.@Spacer {
        @Pad = Padding(Vertical: 12);
      }

      $Herbarium.@TitledContainer #PlantContainerObtainedFrom {
        Group #PlantContainerObtainedFromInteractions {
          LayoutMode: Top;
          Background: (TexturePath: "../textures/SectionBackground.png", Border: 8);
          Padding: (Full: 8);

          Group #InteractionsHeader {
            LayoutMode: CenterMiddle;

            Label #SectionTitle {
              Style: (...$Herbarium.@SectionTitleStyle, VerticalAlignment: Center);
              Text: "";
              FlexWeight: 1;
              Visible: false;
            }

            Group #InteractionsRow {
              LayoutMode: CenterMiddle;

              Group #InteractionBreak {
                Anchor: (Width: 40, Height: 40);
                Background: "../textures/InteractionBreak.png";
                TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
                TooltipText: "";
              }

              Group #InteractionCollect {
                Anchor: (Width: 52, Height: 52);
                Padding: (Left: 12);
                Background: "../textures/InteractionCollect.png";
                TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
                TooltipText: "";
              }

              Group #InteractionShears {
                Anchor: (Width: 48, Height: 48);
                Padding: (Left: 12);
                Background: "../textures/InteractionShears.png";
                TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
                TooltipText: "";
              }
            }
          }

          Group #SectionList {
            LayoutMode: Top;
          }
        }

        $Herbarium.@Spacer #SpacerAfterInteractions { Visible: false; }

        Group #PlantContainerObtainedFromCrafting {
          LayoutMode: Top;
          Background: (TexturePath: "../textures/SectionBackground.png", Border: 8);
          Padding: (Full: 8);

          Group #CraftingHeader {
            LayoutMode: CenterMiddle;

            Label #SectionTitle {
              Style: (...$Herbarium.@SectionTitleStyle, VerticalAlignment: Center);
              Text: "";
              FlexWeight: 1;
              Visible: false;
            }

            AssetImage #BenchIcon {
              Anchor: (Width: 48, Height: 48);
              FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
              TextTooltipStyle: $Common.@DefaultTextTooltipStyle;
              TooltipText: "";
            }
          }

          $Herbarium.@Spacer {
            @Pad = Padding(Vertical: 4);
          }

          Group #SectionList {
            LayoutMode: LeftCenterWrap;
            Anchor: (Full: 0);
          }
        }

        // $Herbarium.@Section #PlantContainerObtainedFromPlants {}
      }

    }

    Label #PlantDiscovery {
      Style: $Herbarium.@PlantStatusStyle;
      Anchor: (Bottom: 35);
      Padding: (Horizontal: 15);
      Text: "";
    }
  }
};
