$Herbarium = "HerbariumCommon.ui";

// One location line. Java sets #LocationText.Text; entries after the first also
// set #TopSpacer.Visible = true to space them.
Group {
  LayoutMode: Top;

  Group #TopSpacer {
    Anchor: (Height: 4);
    Visible: false;
  }

  Label #LocationText {
    Style: $Herbarium.@EntryStyle;
    Text: "";
  }
}
