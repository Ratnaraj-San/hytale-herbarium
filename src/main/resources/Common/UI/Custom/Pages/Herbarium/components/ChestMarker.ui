$Common = "../../../Common.ui";

// One chest state icon (40x40, hidden by default). Set @Tex to the state texture.
// Java addresses the instance IDs (#ChestDisabled, ...) for .Visible + tooltips.
@ChestGroup = Group {
  @Tex = "";

  Anchor: (Left: 0, Bottom: 0, Width: 40, Height: 40);
  Visible: false;
  TextTooltipShowDelay: 0.1;
  LayoutMode: Bottom;
  TextTooltipStyle: $Common.@DefaultTextTooltipStyle;

  Group {
    Background: @Tex;
    Anchor: (Width: 22, Height: 22, Bottom: 10);
  }
};

Group {
  Group #ChestContainer {
    Anchor: (Bottom: 18, Left: -2);

    @ChestGroup #ChestDisabled {
      @Tex = "../textures/MemoriesProgress/IconChestDisabled.png";
    }

    @ChestGroup #ChestActive {
      @Tex = "../textures/MemoriesProgress/IconChestActive.png";
    }

    @ChestGroup #ChestCollected {
      @Tex = "../textures/MemoriesProgress/IconChestCollected.png";
    }

    @ChestGroup #ChestClaimedPending {
      @Tex = "../textures/MemoriesProgress/IconChestClaimedPending.png";
    }

    Group #Arrow {
      Background: "../textures/MemoriesProgress/MemoriesBarArrow.png";
      Anchor: (Left: 14, Width: 10, Height: 8, Bottom: 0);
      Visible: false;
    }
  }
}
