$Herbarium = "HerbariumCommon.ui";

// Source plant tile: same shrunk PlantTile as ingredients, with the row of
// interaction icons below (how the source gives the plant).
Group {
  LayoutMode: Top;

  $Herbarium.@PlantTile #PlantTile {
    @Width = 96;
    @Height = 124;
    @IconSize = 48;
    @Gap = 16;
  }

  $Herbarium.@SourceInteractions #SourceInteractions {}
}
