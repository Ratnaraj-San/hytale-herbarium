$C = "../../Common.ui";
$Sounds = "../../Sounds.ui";

@CategoryButtonLabelStyle = LabelStyle(
  Wrap: true,
  HorizontalAlignment: Center,
  VerticalAlignment: End,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  RenderUppercase: true,
  FontSize: 15
);

@CategoryCounterStyle = LabelStyle(
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  RenderUppercase: true,
  FontSize: 13,
  HorizontalAlignment: End
);

Group {
  Anchor: (Width: 144, Height: 176, Right: 16, Bottom: 16);
  Padding: (Full: 8);

  Group #CompleteCategoryBackground {
    Background: (TexturePath: "Tiles/TileComplete.png", Border: 8);
    Visible: false;
  }

  Group {
    LayoutMode: Right;
    Anchor: (Right: 5, Top: 5);

    Group #NotCompleteCategoryCounter {
      LayoutMode: Right;
      Visible: false;

      Label #CurrentCategoryCountNotComplete {
        Text: "0";
        Style: @CategoryCounterStyle;
      }

      Label {
        Text: "/";
        Style: @CategoryCounterStyle;
      }

      Label #TotalCategoryCountNotComplete {
        Text: "0";
        Style: @CategoryCounterStyle;
      }
    }

    Group #CompleteCategoryCounter {
      LayoutMode: Right;
      Visible: false;

      Group {
        FlexWeight: 1;
      }

      Group {
        Background: "Checkmark.png";
        Anchor: (Width: 16, Height: 16, Right: 5, Top: 0);
      }

      Label #CurrentCategoryCountComplete {
        Text: "0";
        Style: (...@CategoryCounterStyle, TextColor: #39f493);
      }

      Label {
        Text: "/";
        Style: (...@CategoryCounterStyle, TextColor: #39f493);
      }

      Label #TotalCategoryCountComplete {
        Text: "0";
        Style: (...@CategoryCounterStyle, TextColor: #39f493);
      }
    }
  }

  TextButton #Button {
    Padding: (Bottom: 10);
    Style: (
      Sounds: $Sounds.@ButtonsLight,
      Default: (
        LabelStyle: @CategoryButtonLabelStyle,
        Background: (TexturePath: "Tiles/TileDefault.png", Border: 8)
      ),
      Hovered: (
        LabelStyle: @CategoryButtonLabelStyle,
        Background: (TexturePath: "Tiles/TileHovered.png", Border: 8)
      )
    );
    FlexWeight: 1;
  }

  AssetImage #CategoryIcon {
    Anchor: (Width: 112, Height: 112);
    FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
  }
}
